<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/change_password_title"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/oldPassInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_input"
        android:hint="@string/cur_password_hint"
        android:textColorHint="@color/dim"
        android:textColor="@color/text"
        android:inputType="textPassword"
        android:maxLines="1" />

    <EditText
        android:id="@+id/newPassInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/new_password_hint"
        android:textColorHint="@color/dim"
        android:textColor="@color/text"
        android:inputType="textPassword"
        android:maxLines="1" />

    <EditText
        android:id="@+id/repeatPassInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:hint="@string/repeat_password_hint"
        android:textColorHint="@color/dim"
        android:textColor="@color/text"
        android:inputType="textPassword"
        android:maxLines="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/changePassCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/cancel"
            android:textColor="@color/text"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:layout_marginEnd="10dp" />

        <Button
            android:id="@+id/changePassSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_primary"
            android:text="@string/change"
            android:textColor="@color/bg"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:elevation="0dp" />
    </LinearLayout>
</LinearLayout>
