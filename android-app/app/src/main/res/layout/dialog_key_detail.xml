<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/detailName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detailType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="140dp">
        <TextView
            android:id="@+id/detailSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/text"
            android:textSize="10.5sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="18dp">

        <Button
            android:id="@+id/detailDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_danger"
            android:text="@string/delete"
            android:textColor="@color/danger"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/detailCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/copy"
            android:textColor="@color/text"
            android:textAllCaps="false"
            android:elevation="0dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/detailClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_ghost"
            android:text="@string/close"
            android:textColor="@color/text"
            android:textAllCaps="false"
            android:elevation="0dp" />
    </LinearLayout>
</LinearLayout>
