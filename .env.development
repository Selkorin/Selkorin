# Environment
NODE_ENV=development
PORT=3000

# Database - SQLite for local development
USE_SQLITE=true
DB_PATH=./data/wai.db

# Database - PostgreSQL (uncomment to switch)
# USE_SQLITE=false
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=wai_social_agent

# AI Providers
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-api-key-here

# Yandex Places API (Geosearch) — лид-ген с Яндекс.Карт
# Бесплатный ключ: https://developer.tech.yandex.ru/ (сервис "Geosearch")
YANDEX_MAPS_API_KEY=your-yandex-geosearch-key-here

# Google Drive (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback

# JWT
JWT_SECRET=dev-secret-key-change-in-production

# WAI System
WAI_APP_ID=demo-app-id
WAI_WEBHOOK_SECRET=demo-webhook-secret

# Seed Data
SEED_DATA_ENABLED=true

# Logging
LOG_LEVEL=debug

# CORS
CORS_ORIGIN=http://localhost:3001
