// Общие параметры установки Selkorin Sky Sentinel.
// Все размеры в миллиметрах. Подключается в остальные .scad через include.

// --- Основание / поворотная платформа ---
base_d       = 160;   // диаметр опорной платформы
base_h       = 12;    // толщина платформы
bearing_d    = 60;    // посадочный диаметр упорного подшипника азимута
bearing_h    = 15;

// --- Вилка (yoke) возвышения ---
yoke_h       = 120;   // высота щёк вилки
yoke_w       = 90;    // расстояние между внутренними поверхностями щёк
yoke_t       = 8;     // толщина щеки
yoke_base    = 100;   // ширина основания вилки

// --- Оптическая площадка ---
optics_l     = 140;   // длина площадки
optics_w     = 70;    // ширина
optics_t     = 6;     // толщина
optics_axle  = 8;     // диаметр оси возвышения

// --- Крепёж двигателя NEMA17 ---
motor_flange = 42.3;  // фланец
motor_hole   = 31.0;  // межцентровое отверстий крепления
motor_shaft  = 5.0;   // вал
motor_bore   = 22.0;  // центральная выборка

// --- Прочее ---
wall         = 3;     // толщина стенок печатных деталей
m3           = 3.4;   // отверстие под M3 (с зазором)
m4           = 4.5;   // отверстие под M4
$fn          = 64;    // гладкость окружностей
