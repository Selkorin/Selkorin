#!/usr/bin/env bash
# Двойной клик в Finder запустит WAI локально и откроет браузер.
# Если macOS ругается «неизвестный разработчик» — правый клик по файлу → «Открыть».
cd "$(dirname "$0")"
./start-local.sh
echo ""
echo "Сервер остановлен. Можно закрыть это окно."
read -n 1 -s -r -p "Нажми любую клавишу для выхода..."
