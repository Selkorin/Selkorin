# ── Режим ────────────────────────────────────────────────────────────────────
# demo — работает без ключей на демо-данных. live — реальные источники и Telegram.
LEADGEN_MODE=demo

# ── AI (Claude): скоринг лидов и генерация сообщений ──────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Яндекс (официальные API) ──────────────────────────────────────────────────
# Yandex Search API (XML), формат: user:key
YANDEX_SEARCH_API_KEY=
# Yandex Geosearch/Places API (Яндекс.Карты)
YANDEX_MAPS_API_KEY=

# ── Безопасные лимиты Telegram-автоматизации (защита от блокировки) ───────────
TG_MIN_DELAY_SEC=8
TG_MAX_DELAY_SEC=22
TG_DAILY_MESSAGE_LIMIT=40
TG_DAILY_REACTION_LIMIT=120

# ── Сервер ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
