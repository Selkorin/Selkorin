{
  "name": "remote-support-app",
  "version": "0.1.0",
  "description": "Local Wi-Fi remote support for mobile devices with explicit consent",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/server",
    "packages/shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "start": "npm start --workspace=apps/server",
    "typecheck": "npm run typecheck --workspaces"
  },
  "engines": {
    "node": "20.x"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
