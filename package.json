{
  "name": "wai-social-agent",
  "version": "0.1.0",
  "description": "AI SMM Agent for WAI System",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:reset": "SEED_CLEAR=true npm run seed",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run build"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/generative-ai": "^0.24.1",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "googleapis": "^118.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.20.0",
    "pg": "^8.10.0",
    "sqlite3": "^5.1.6",
    "typeorm": "^0.3.16"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.5.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
